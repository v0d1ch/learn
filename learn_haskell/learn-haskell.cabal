cabal-version: 3.0
name: learn-haskell
version: 0.1.0.0
synopsis: Continuations, operational programs, and typed state-machine exercises
build-type: Simple
tested-with: GHC ==9.6.7
extra-source-files:
  README.md
  cabal.project
  cabal.project.freeze

common exercise
  default-language: GHC2021
  hs-source-dirs: exercises
  build-depends: base >=4.18 && <4.19
  ghc-options: -O0

executable cont
  import: exercise
  main-is: ContExercise.hs
  other-modules: ContPredictions

executable free-monad
  import: exercise
  main-is: FreeMonadExercise.hs

executable hydra-program
  import: exercise
  main-is: HydraProgramExercise.hs

executable crem
  import: exercise
  main-is: CremExercise.hs
  build-depends: crem ==0.1.1.0

executable crem-program
  import: exercise
  main-is: CremProgramExercise.hs
  build-depends: crem ==0.1.1.0

